<?xml version="1.0" encoding="utf-8"?>
<!--
  Autorise le HTTP en clair vers la machine de développement, et elle seule.

  Depuis Android 9, le trafic non chiffré est refusé par défaut. Sans cette
  exception, l'app tournant dans l'émulateur ne peut pas atteindre le serveur
  Next lancé sur le PC — et l'échec est muet côté système, ce qui se diagnostique
  très mal depuis la WebView.

  `10.0.2.2` est l'alias par lequel l'émulateur Android joint son hôte ;
  `localhost` désignerait l'émulateur lui-même. `10.0.2.16` et `127.0.0.1`
  couvrent les variantes selon les versions d'émulateur.

  ⚠️ Ce fichier vit dans `src/debug/`, donc **il n'est présent que dans les builds
  de débogage**. Les builds de publication conservent le refus par défaut. Ne pas
  le déplacer dans `src/main/`.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.2.16</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
